{
  "info": {
    "name": "Sistem Manajemen Toko Fotokopi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection presentasi. Jalankan npm start dan pastikan barang awal sudah diisi dengan npm run seed. Mulai dari 0. Health Check, lalu jalankan folder berurutan. Barang CRUD contoh dihapus di akhir folder Barang; restock dan penjualan dibatalkan untuk mengembalikan stok. Jika berhenti di tengah, perubahan yang sudah dikirim tetap berlaku. Jangan mengirim ulang penjualan yang sudah berhasil tanpa memeriksa riwayat.\n\nArti variabel: pulpenPilotId = Pulpen Pilot Hitam; bukuTulisId = Buku Tulis Sinar Dunia 38; pulpenContohId = pulpen baru dari langkah 3. Arahkan mouse ke {{baseUrl}} untuk melihat nilainya, atau buka Variables pada collection. ID harus diambil dari field _id response, bukan nomor TRX/RST. Jangan mengisi ID sendiri jika mengikuti langkah berurutan."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string",
      "description": "Alamat API lokal. Tidak perlu diganti jika server menggunakan port 3000."
    },
    {
      "key": "kodeContoh",
      "value": "",
      "type": "string",
      "description": "Angka unik untuk nama pulpen contoh. Diisi otomatis saat mengirim 0. Health Check."
    },
    {
      "key": "pulpenPilotId",
      "value": "",
      "type": "string",
      "description": "ID Pulpen Pilot Hitam. Diisi otomatis dari folder Barang, langkah 1: READ semua barang."
    },
    {
      "key": "bukuTulisId",
      "value": "",
      "type": "string",
      "description": "ID Buku Tulis Sinar Dunia 38. Diisi otomatis dari folder Barang, langkah 1: READ semua barang."
    },
    {
      "key": "pulpenContohId",
      "value": "",
      "type": "string",
      "description": "ID pulpen baru yang dibuat pada langkah 3. Dipakai untuk READ detail, PUT, PATCH, dan DELETE pada langkah 4–7."
    },
    {
      "key": "restockContohId",
      "value": "",
      "type": "string",
      "description": "ID restock dari langkah Tambah restock. Dipakai untuk detail dan pembatalan restock tersebut."
    },
    {
      "key": "penjualanContohId",
      "value": "",
      "type": "string",
      "description": "ID penjualan dari langkah Catat penjualan. Dipakai untuk detail dan pembatalan penjualan tersebut."
    },
    {
      "key": "waktuDibuat",
      "value": "",
      "type": "string",
      "description": "createdAt pulpen contoh. Diisi otomatis dan hanya dipakai untuk menguji timestamp; tidak perlu diisi manual."
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "description": "",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('kodeContoh', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Barang - CRUD dan Error",
      "item": [
        {
          "name": "1. READ - Ambil semua barang",
          "request": {
            "method": "GET",
            "description": "Menampilkan barang dan menyimpan ID dua barang yang jelas namanya: Pulpen Pilot Hitam dan Buku Tulis Sinar Dunia 38. Klik Send terlebih dahulu sebelum mencoba folder Restock/Penjualan. Nilainya dapat dilihat di collection → Variables.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/barang?sort=terbaru&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "terbaru",
                  "description": "Urutkan barang terbaru dahulu."
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Jumlah maksimal barang yang ditampilkan."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const rows = pm.response.json().data;",
                  "const pulpen = rows.find(item => item.nama === 'Pulpen Pilot Hitam');",
                  "const buku = rows.find(item => item.nama === 'Buku Tulis Sinar Dunia 38');",
                  "pm.collectionVariables.set('pulpenPilotId', pulpen ? pulpen._id : '');",
                  "pm.collectionVariables.set('bukuTulisId', buku ? buku._id : '');",
                  "pm.test('Pulpen Pilot dan Buku Tulis tersedia; jalankan npm run seed jika belum ada', () => { pm.expect(pulpen).to.exist; pm.expect(buku).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. READ - Cari pulpen (Query Parameter)",
          "request": {
            "method": "GET",
            "description": "",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/barang?kategori=Alat%20Tulis&q=pulpen&sort=stok",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang"
              ],
              "query": [
                {
                  "key": "kategori",
                  "value": "Alat Tulis",
                  "description": "Nama kategori barang yang dicari."
                },
                {
                  "key": "q",
                  "value": "pulpen",
                  "description": "Teks nama barang yang dicari, misalnya pulpen."
                },
                {
                  "key": "sort",
                  "value": "stok",
                  "description": "Urutkan dari stok paling sedikit."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. CREATE - Tambah pulpen contoh",
          "request": {
            "method": "POST",
            "description": "Membuat barang baru bernama Pulpen Presentasi + kode unik. ID hasil response disimpan sebagai pulpenContohId. Barang ini yang dipakai dalam langkah 4, 5, 6, dan 7; berbeda dari Pulpen Pilot Hitam milik data awal.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/barang",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Pulpen Presentasi {{kodeContoh}}\",\n  \"kategori\": \"Alat Tulis\",\n  \"harga\": 3500,\n  \"stok\": 10,\n  \"stokMinimum\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('pulpenContohId', pm.response.json().data._id);",
                  "pm.collectionVariables.set('waktuDibuat', pm.response.json().data.createdAt);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. READ - Detail pulpen dari langkah 3",
          "request": {
            "method": "GET",
            "description": "Menampilkan pulpen contoh yang baru ditambahkan pada langkah 3. {{pulpenContohId}} berisi _id dari response CREATE. Hover variabel untuk melihat ID aslinya.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/barang/{{pulpenContohId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang",
                "{{pulpenContohId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. PUT - Ganti data pulpen contoh",
          "request": {
            "method": "PUT",
            "description": "Mengganti nama, kategori, harga, dan stok minimum pulpen dari langkah 3. Semua 4 field harus diisi. Stok dan timestamp tidak dikirim.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/barang/{{pulpenContohId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang",
                "{{pulpenContohId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Pulpen Gel Presentasi {{kodeContoh}}\",\n  \"kategori\": \"Alat Tulis\",\n  \"harga\": 4500,\n  \"stokMinimum\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('createdAt tidak berubah', () => pm.expect(pm.response.json().data.createdAt).to.eql(pm.collectionVariables.get('waktuDibuat')));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. PATCH - Ubah harga pulpen contoh",
          "request": {
            "method": "PATCH",
            "description": "Mengubah hanya harga pulpen dari langkah 3 menjadi Rp5.000. Field lainnya tetap.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/barang/{{pulpenContohId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang",
                "{{pulpenContohId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harga\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. DELETE - Hapus pulpen dari langkah 3",
          "request": {
            "method": "DELETE",
            "description": "Menghapus permanen pulpen contoh dari langkah 3 (namanya menjadi Pulpen Gel Presentasi setelah PUT). {{pulpenContohId}} menunjukkan ID barang tersebut. Body: none, karena DELETE memilih barang melalui ID di URL. Pulpen Pilot Hitam dan Buku Tulis data awal tidak dihapus oleh request ini.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/barang/{{pulpenContohId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang",
                "{{pulpenContohId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
