                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. ERROR - Nama kosong (400)",
          "request": {
            "method": "POST",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/barang",
