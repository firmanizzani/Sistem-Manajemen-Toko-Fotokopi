          "raw": "{{baseUrl}}/api/barang",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "barang"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Demo Pulpen {{suffix}}\",\n  \"kategori\": \"Demo\",\n  \"harga\": 3500,\n  \"stok\": 0,\n  \"stokMinimum\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
