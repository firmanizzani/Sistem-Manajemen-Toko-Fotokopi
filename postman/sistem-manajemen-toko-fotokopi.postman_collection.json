          "name": "3. CREATE - Tambah pulpen Standard",
          "request": {
            "method": "POST",
            "description": "Buat pulpen baru; simpan ID otomatis.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/barang",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barang"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Pulpen Standard AE7 Hitam {{kodeBarang}}\",\n  \"kategori\": \"Alat Tulis\",\n  \"harga\": 3500,\n  \"stok\": 10,\n  \"stokMinimum\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const kode = Date.now().toString() + '-' + Math.floor(Math.random() * 1000000);",
                  "pm.collectionVariables.set('kodeBarang', kode);",
                  "pm.variables.set('kodeBarang', kode);",
                  "pm.collectionVariables.set('pulpenStandardId', '');",
                  "pm.collectionVariables.set('waktuDibuat', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const result = pm.response.json().data;",
                  "if (pm.response.code === 201 && result && /^[a-f0-9]{24}$/i.test(result._id || '')) {",
                  "  pm.collectionVariables.set('pulpenStandardId', result._id);",
                  "  pm.collectionVariables.set('waktuDibuat', result.createdAt);",
                  "}",
                  "pm.test('ID tersimpan otomatis', () => { pm.expect(pm.collectionVariables.get('pulpenStandardId')).to.match(/^[a-f0-9]{24}$/i); pm.expect(pm.collectionVariables.get('pulpenStandardId')).to.eql(result && result._id); });"
                ]
              }
            }
          ]
        },
