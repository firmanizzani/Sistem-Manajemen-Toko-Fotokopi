                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. PATCH - Batalkan restock",
          "request": {
            "method": "PATCH",
            "description": "Membatalkan restock dari langkah 1 sehingga 10 pulpen dan 5 buku dikurangi kembali. Isi alasan pada Body. Bisa gagal jika stok sudah tidak cukup.",
            "header": [
              {
