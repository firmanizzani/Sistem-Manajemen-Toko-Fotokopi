            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Response hanya satu data', () => { const data = pm.response.json().data; pm.expect(Array.isArray(data)).to.eql(false); pm.expect(data._id).to.eql(pm.collectionVariables.get('pulpenStandardId')); });"
                ]
              }
            }
