                  "    pm.execution.skipRequest();",
                  "    break;",
                  "  }",
                  "  pm.variables.set(key, id);",
                  "}",
                  "if (pm.collectionVariables.get('kodeBarang')) pm.variables.set('kodeBarang', pm.collectionVariables.get('kodeBarang'));"
                ]
