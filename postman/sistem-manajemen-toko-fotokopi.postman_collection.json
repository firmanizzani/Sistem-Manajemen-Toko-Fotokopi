    {
      "name": "2. Restock",
      "item": [
        {
          "name": "1. POST - Restock Pulpen Pilot dan Buku Tulis",
          "request": {
            "method": "POST",
            "description": "Menambah 10 Pulpen Pilot Hitam dan 5 Buku Tulis Sinar Dunia 38. pulpenPilotId/bukuTulisId diisi dari Barang → 1. READ. Jumlah berarti tambahan stok, bukan stok akhir.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/restock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "restock"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"barangId\": \"{{pulpenPilotId}}\",\n      \"jumlah\": 10\n    },\n    {\n      \"barangId\": \"{{bukuTulisId}}\",\n      \"jumlah\": 5\n    }\n  ],\n  \"catatan\": \"Restock untuk presentasi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('restockContohId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. GET - Riwayat restock Pulpen Pilot",
          "request": {
            "method": "GET",
            "description": "Menampilkan restock selesai yang memuat Pulpen Pilot Hitam. Query barangId memakai {{pulpenPilotId}}, bukan ID barang sembarang.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restock?status=selesai&barangId={{pulpenPilotId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "restock"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "selesai",
                  "description": "Status riwayat yang ingin ditampilkan, misalnya selesai."
                },
                {
                  "key": "barangId",
                  "value": "{{pulpenPilotId}}",
                  "description": "ID Pulpen Pilot Hitam; otomatis dari Barang → 1. READ semua barang."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response sesuai', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. READ - Detail restock",
          "request": {
            "method": "GET",
            "description": "Menampilkan restock contoh yang dibuat pada langkah 1 folder Restock. restockContohId adalah _id restock, bukan ID barang atau nomor RST.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restock/{{restockContohId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
