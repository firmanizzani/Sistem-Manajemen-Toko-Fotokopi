{
  "name": "sistem-manajemen-toko-fotokopi",
  "version": "1.0.0",
  "description": "REST API inventaris dan transaksi toko fotokopi menggunakan ExpressJS dan MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed:restock": "node scripts/seed-restock.js",
    "seed:transaksi": "node scripts/seed-transaksi.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/postman.test.js",
    "test:postman": "node --test --test-concurrency=1 tests/postman.test.js"
  },
  "keywords": [],
  "author": "Muhammad Firman Izzani",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.2"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "supertest": "^7.3.2"
  }
}
